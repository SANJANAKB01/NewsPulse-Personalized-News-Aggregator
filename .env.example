# Local dev environment variables
# Copy to backend/.env and edit values as needed.

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# PostgreSQL connection (matches docker-compose.yml)
# DATABASE_URL=postgresql+psycopg2://news:news@localhost:5432/news_aggregator
DATABASE_URL=sqlite:///news.db
# Auth secrets - CHANGE THESE in production
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=replace-with-another-long-random-string

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- News sources ---
# NewsAPI (https://newsapi.org/register)
NEWSAPI_KEY=ef8b3f9a030b4a4b9537a77c307a68bd

# Reddit (https://www.reddit.com/prefs/apps - create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=news-aggregator/1.0
REDDIT_SUBREDDITS=worldnews,technology,science,business,sports,UpliftingNews

# GDELT (no key needed)
GDELT_BASE=https://api.gdeltproject.org/api/v2

# --- Recommendation engine ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_EMBEDDINGS=1
RECOMMEND_TOP_K=30

# --- Scheduler ---
SCHEDULER_ENABLED=1
SCHEDULER_FETCH_MINUTES=30

# --- Newsletter SMTP (optional - leave blank to stub) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NEWSLETTER_FROM=digest@news-aggregator.local
